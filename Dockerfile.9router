# ==========================================
# Stage 1: Extract a pinned Litestream binary.
# Keep the tag and manifest digest in sync when upgrading.
# ==========================================
FROM litestream/litestream:0.5.17@sha256:4b02b9859a6b6b4087d8b8944e15f7e984bd7957cba322bbeee38b0e27b9656a AS litestream_bin

# ==========================================
# Stage 2: Wrap the official 9Router image.
# 9Router v0.5.95, pinned to its multi-architecture manifest.
# Keep the tag and manifest digest in sync when upgrading.
# ==========================================
FROM decolua/9router:0.5.109@sha256:28474ba417ac76198abce43b6758b187201e0acac364f72ff3918b0f7e11b040
USER root

# Use the same in-container layout as the 9router-go profile. The upstream
# image defaults to /app/data, but its database contract is $DATA_DIR/db/data.sqlite.
ENV NODE_ENV=production \
    PORT=20128 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1 \
    DATA_DIR=/data \
    DB_PATH=/data/db/data.sqlite \
    LITESTREAM_DB_PATH=/data/db/data.sqlite \
    LITESTREAM_EXPECTED_DATA_DIR=/data \
    LITESTREAM_EXPECTED_DB_PATH=/data/db/data.sqlite \
    APP_USER=node \
    APP_GROUP=node

# The upstream image already contains su-exec for its own entrypoint. The
# shared wrapper uses it so the app and Litestream run as the same user.
RUN mkdir -p /data/db && chown -R node:node /data

COPY --from=litestream_bin /usr/local/bin/litestream /usr/local/bin/litestream
COPY litestream.yml /etc/litestream.yml
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 20128

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "custom-server.js"]
